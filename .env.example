# CropMitra Environment Variables Configuration

# Database Connection URL (SQLite default, PostgreSQL in production)
DATABASE_URL=sqlite:///./cropmitra.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/cropmitra_db

# ML Model Paths
CROP_MODEL_PATH=backend/ml/models/crop_model.joblib
FERTILIZER_MODEL_PATH=backend/ml/models/fertilizer_model.joblib

# Frontend API URL (leave empty for Vite proxy in development)
VITE_API_URL=
